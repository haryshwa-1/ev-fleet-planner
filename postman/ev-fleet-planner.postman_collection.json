    {
      "name": "2 Read the plan",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/shifts/{{shiftId}}/plan/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shifts",
                "{{shiftId}}",
                "plan",
                "summary"
              ]
            },
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test(\"300-cab shift\", () => { const r = pm.response.json(); pm.expect(r.totalTrips === 1500).to.be.true; });",
                  "pm.test(\"planned within 30 s\", () => { const r = pm.response.json(); pm.expect(r.planningMillis < 30000).to.be.true; });",
                  "pm.test(\"gap is reported\", () => { const r = pm.response.json(); pm.expect(r.gap >= 0).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Backup trips with reasons",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/shifts/{{shiftId}}/plan/unassigned",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shifts",
                "{{shiftId}}",
                "plan",
                "unassigned"
              ]
            },
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test(\"every trip has a reason\", () => { const r = pm.response.json(); pm.expect(r.every(u => !!u.reason)).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Cab timeline",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/shifts/{{shiftId}}/cabs/CAB-007/timeline",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shifts",
                "{{shiftId}}",
                "cabs",
                "CAB-007",
                "timeline"
              ]
            },
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test(\"charge shown at each step\", () => { const r = pm.response.json(); pm.expect(r.every(a => a.socStartKWh !== undefined && a.socEndKWh !== undefined)).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Run the validator",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/shifts/{{shiftId}}/plan/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shifts",
                "{{shiftId}}",
                "plan",
                "validate"
              ]
            },
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operatorToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test(\"plan is valid\", () => { const r = pm.response.json(); pm.expect(r.valid === true).to.be.true; });"
                ]
              }
            }
          ]
        }
      ]
