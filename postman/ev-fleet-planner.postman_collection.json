{
  "info": {
    "name": "EV Fleet Planner",
    "description": "Run in order against a freshly started `docker compose up`. Every request checks its own result. Demo password only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "password",
      "value": "demo-password"
    },
    {
      "key": "shiftId",
      "value": "1"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "operatorToken",
      "value": ""
    },
    {
      "key": "employeeToken",
      "value": ""
    },
    {
      "key": "globexToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Login",
      "item": [
        {
          "name": "Login admin@acme",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin@acme\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
