            "body": {
              "mode": "raw",
              "raw": "{\n  \"cabId\": \"CAB-007\",\n  \"socPercent\": 22,\n  \"observedAt\": \"19:30\",\n  \"seq\": 1,\n  \"idempotencyKey\": \"postman-drift-1\"\n}"
            }
