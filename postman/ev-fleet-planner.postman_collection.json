                  "pm.test(\"under 2 s\", () => { const r = pm.response.json(); pm.expect(r.replanMillis < 2000).to.be.true; });",
                  "pm.test(\"not a duplicate\", () => { const r = pm.response.json(); pm.expect(r.duplicate === false).to.be.true; });"
                ]
              }
